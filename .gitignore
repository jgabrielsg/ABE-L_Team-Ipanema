# ==============================================================================
# .gitignore — Team Ipanema (ABE-L) | ASA Data Quest 2026
# Estrutura Profissional de Engenharia de Dados & Data Science
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ambientes Virtuais e Interpretadores Python
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.env
.env.*
!.env.example

# ------------------------------------------------------------------------------
# 2. Bytecode e Cache Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 3. Jupyter Notebooks & Editores Interativos
# ------------------------------------------------------------------------------
.ipynb_checkpoints
*/.ipynb_checkpoints/*
tempCodeRunnerFile.py
*.nbconvert.ipynb

# ------------------------------------------------------------------------------
# 4. Dados e Arquivos Volumosos (Data Engineering Best Practices)
# ATENÇÃO: Bases brutas e intermediárias nunca devem ser comitadas (>100MB bloqueia GitHub)
# ------------------------------------------------------------------------------
data/01_raw/*
!data/01_raw/.gitkeep
!data/01_raw/README.md

data/02_processed/*
!data/02_processed/.gitkeep

data/03_curated/*
!data/03_curated/.gitkeep

# Arquivos brutos específicos do WPP 2024 (incluindo versões extraídas sem extensão)
data/WPP2024_Demographic_Indicators_Medium_csv*
data/WPP2024_Demographic_Indicators_OtherVariants_csv*
!data/WPP2024_Demographic_Indicators_notes.csv

# Extensões volumosas em qualquer pasta de dados
*.csv.gz
*.gz
*.parquet
*.feather
*.h5
*.pickle
*.pkl
*.zip
*.tar
*.7z

# ------------------------------------------------------------------------------
# 5. Saídas Geradas (Outputs de Execução)
# ------------------------------------------------------------------------------
# Manter as pastas com .gitkeep, mas ignorar arquivos temporários ou muito pesados se necessário
outputs/tables/*.csv
outputs/reports/*.pdf
outputs/reports/*.docx
!outputs/graphics/.gitkeep
!outputs/tables/.gitkeep
!outputs/reports/.gitkeep

# ------------------------------------------------------------------------------
# 6. IDEs e Ferramentas do Sistema Operacional
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
